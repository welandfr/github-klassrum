# The deployment is a git checkout: never serve the repository metadata.
# (Require is used because it is known to be allowed here; see config/.htaccess.)
<If "%{REQUEST_URI} =~ m#/\.git(/|$)#">
    Require all denied
</If>

# Temporary data files, e.g. a list of students (see .gitignore).
<If "%{REQUEST_URI} =~ m#\.tmp$#">
    Require all denied
</If>
