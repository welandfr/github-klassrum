# Mini-Classroom configuration. Copy to ~/classroom-config/.env (outside the web root,
# preferred) or config/.env, and fill in. Never commit the copy.
# Format: KEY=VALUE per line; optional surrounding quotes are removed; a # inside a value is kept.
# Real environment variables (e.g. Apache SetEnv) override these.

# SSO usernames ($_SERVER['REMOTE_USER']) allowed on the admin pages, comma-separated.
ADMINS=

# SQLite database file. Default: classroom.sqlite next to this .env file. Its directory must be
# writable by the web server, and should be outside the web root.
# DB_PATH=

# Local dev only: 1 = disposable database. Lets PHP's built-in server auto-apply
# migrations and offer "Reset database". Leave unset for any real database.
# DB_IS_DEV=1
